msgid "Accessibility Plus Options"
msgstr "Optionen für Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Textskalierung aktivieren"

msgid "Allow users to scale UI text size."
msgstr "Nutzern erlauben, die Textgröße zu ändern."

msgid "Enable Contrast Modes"
msgstr "Kontrastmodi aktivieren"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Nutzern erlauben, hohen Kontrast, Invertierung oder Graustufen einzuschalten."

msgid "Enable Link Highlighting"
msgstr "Linkhervorhebung aktivieren"

msgid "Allow users to highlight clickable links."
msgstr "Nutzern erlauben, anklickbare Links hervorzuheben."

msgid "Enable Font Options"
msgstr "Schriftoptionen aktivieren"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Nutzern erlauben, zu einer gut lesbaren (Atkinson Hyperlegible) oder legasthenikerfreundlichen (OpenDyslexic) Schrift zu wechseln."

msgid "Enable Text Spacing"
msgstr "Textabstände aktivieren"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Nutzern erlauben, Zeilen-, Buchstaben- und Wortabstände zu vergrößern (Werte nach WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Bewegungsstopp aktivieren"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Nutzern erlauben, Animationen, Übergänge und andere bewegte Inhalte anzuhalten."

msgid "Enable Big Cursor"
msgstr "Großen Mauszeiger aktivieren"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Nutzern erlauben, den Mauszeiger zu vergrößern (auf Touchscreens ausgeblendet)."

msgid "Default Widget Position"
msgstr "Standardposition der Schaltfläche"

msgid "Select default corner location for the accessibility button."
msgstr "Wählen Sie die Ecke, in der die Barrierefreiheits-Schaltfläche zunächst erscheint."

msgid "Bottom Right"
msgstr "Unten rechts"

msgid "Bottom Left"
msgstr "Unten links"

