msgstr "Kontrast: %1$s (klõpsa muutmiseks)"

msgid "Font: %1$s (click to change)"
msgstr "Font: %1$s (klõpsa muutmiseks)"

msgid "Accessibility menu opened"
msgstr "Ligipääsetavuse menüü avatud"

msgid "Accessibility menu closed"
msgstr "Ligipääsetavuse menüü suletud"

msgid "All accessibility settings reset to default"
msgstr "Kõik ligipääsetavuse seaded on lähtestatud"

msgid "Widget moved to the left"
msgstr "Nupp liigutati vasakule"

msgid "Widget moved to the right"
msgstr "Nupp liigutati paremale"

msgid "Text size increased to %1$s percent"
msgstr "Teksti suurus suurendati %1$s protsendini"

msgid "Text size decreased to %1$s percent"
msgstr "Teksti suurus vähendati %1$s protsendini"

msgid "Contrast mode off"
msgstr "Kontrastirežiim väljas"

msgid "Contrast mode: %1$s"
msgstr "Kontrastirežiim: %1$s"

