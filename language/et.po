msgid "Accessibility Plus Options"
msgstr "Accessibility Plusi valikud"

msgid "Enable Text Scaling"
msgstr "Luba teksti suuruse muutmine"

msgid "Allow users to scale UI text size."
msgstr "Luba kasutajatel teksti suurust muuta."

msgid "Enable Contrast Modes"
msgstr "Luba kontrastirežiimid"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Luba kasutajatel lülitada sisse kõrge kontrast, pööratud värvid või halltoonid."

msgid "Enable Link Highlighting"
msgstr "Luba linkide esiletõstmine"

msgid "Allow users to highlight clickable links."
msgstr "Luba kasutajatel klõpsatavaid linke esile tõsta."

msgid "Enable Font Options"
msgstr "Luba fondivalikud"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Luba kasutajatel lülituda paremini loetavale (Atkinson Hyperlegible) või düsleksiasõbralikule (OpenDyslexic) fondile."

msgid "Enable Text Spacing"
msgstr "Luba tekstivahed"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Luba kasutajatel suurendada rea-, tähe- ja sõnavahet (WCAG 1.4.12 väärtused)."

msgid "Enable Stop Motion"
msgstr "Luba liikumise peatamine"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Luba kasutajatel peatada animatsioonid, üleminekud ja muu liikuv sisu."

msgid "Enable Big Cursor"
msgstr "Luba suur kursor"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Luba kasutajatel hiirekursorit suurendada (puuteekraanidel peidetud)."

msgid "Default Widget Position"
msgstr "Nupu vaikeasukoht"

msgid "Select default corner location for the accessibility button."
msgstr "Vali nurk, kus ligipääsetavuse nupp algul kuvatakse."

msgid "Bottom Right"
msgstr "All paremal"

msgid "Bottom Left"
msgstr "All vasakul"

msgid "Accessibility Options"
msgstr "Ligipääsetavuse valikud"

msgid "Accessibility Settings Panel"
msgstr "Ligipääsetavuse seadete paneel"

msgid "Accessibility"
msgstr "Ligipääsetavus"

msgid "Move widget to left"
msgstr "Liiguta nupp vasakule"

msgid "Move widget to right"
msgstr "Liiguta nupp paremale"

msgid "Close Panel"
msgstr "Sulge paneel"

msgid "Text Size"
msgstr "Teksti suurus"

