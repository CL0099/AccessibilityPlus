msgstr "Vaikefont taastatud"

msgid "%1$s font enabled"
msgstr "Font %1$s sisse lülitatud"

msgid "Link highlighting enabled"
msgstr "Linkide esiletõstmine sees"

msgid "Link highlighting disabled"
msgstr "Linkide esiletõstmine väljas"

msgid "Wider text spacing enabled"
msgstr "Suuremad tekstivahed sees"

msgid "Wider text spacing disabled"
msgstr "Suuremad tekstivahed väljas"

