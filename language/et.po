msgstr "Vähenda teksti"

msgid "Increase text size"
msgstr "Suurenda teksti"

msgid "Contrast"
msgstr "Kontrast"

msgid "Links"
msgstr "Lingid"

msgid "Highlight all clickable links"
msgstr "Tõsta kõik klõpsatavad lingid esile"

msgid "Font"
msgstr "Font"

msgid "Spacing"
msgstr "Vahed"

msgid "Wider text spacing"
msgstr "Suuremad tekstivahed"

msgid "Stop Motion"
msgstr "Peata liikumine"

msgid "Stop animations and moving content"
msgstr "Peata animatsioonid ja liikuv sisu"

msgid "Big Cursor"
msgstr "Suur kursor"

msgid "Large mouse pointer"
msgstr "Suur hiirekursor"

msgid "Reset"
msgstr "Lähtesta"

msgid "Reset all tools to default"
msgstr "Lähtesta kõik tööriistad"

msgid "Close"
msgstr "Sulge"

msgid "Close Accessibility Panel"
msgstr "Sulge ligipääsetavuse paneel"

