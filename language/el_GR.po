msgid "Accessibility Plus Options"
msgstr "Επιλογές του Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Ενεργοποίηση μεγέθους κειμένου"

msgid "Allow users to scale UI text size."
msgstr "Επιτρέπει στους χρήστες να αλλάζουν το μέγεθος του κειμένου."

msgid "Enable Contrast Modes"
msgstr "Ενεργοποίηση λειτουργιών αντίθεσης"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Επιτρέπει στους χρήστες να ενεργοποιούν υψηλή αντίθεση, αντεστραμμένα χρώματα ή κλίμακα του γκρι."

msgid "Enable Link Highlighting"
msgstr "Ενεργοποίηση επισήμανσης συνδέσμων"

msgid "Allow users to highlight clickable links."
msgstr "Επιτρέπει στους χρήστες να επισημαίνουν τους συνδέσμους που μπορούν να πατηθούν."

msgid "Enable Font Options"
msgstr "Ενεργοποίηση επιλογών γραμματοσειράς"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Επιτρέπει στους χρήστες να αλλάζουν σε πιο ευανάγνωστη γραμματοσειρά (Atkinson Hyperlegible) ή σε γραμματοσειρά για άτομα με δυσλεξία (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Ενεργοποίηση αποστάσεων κειμένου"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Επιτρέπει στους χρήστες να αυξάνουν την απόσταση γραμμών, γραμμάτων και λέξεων (τιμές κατά WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Ενεργοποίηση διακοπής κίνησης"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Επιτρέπει στους χρήστες να σταματούν κινούμενα σχέδια, μεταβάσεις και άλλο κινούμενο περιεχόμενο."

msgid "Enable Big Cursor"
msgstr "Ενεργοποίηση μεγάλου δείκτη"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Επιτρέπει στους χρήστες να μεγεθύνουν τον δείκτη του ποντικιού (κρυφό σε οθόνες αφής)."

msgid "Default Widget Position"
msgstr "Προεπιλεγμένη θέση κουμπιού"

msgid "Select default corner location for the accessibility button."
msgstr "Επιλέξτε τη γωνία όπου εμφανίζεται αρχικά το κουμπί προσβασιμότητας."

msgid "Bottom Right"
msgstr "Κάτω δεξιά"

msgid "Bottom Left"
msgstr "Κάτω αριστερά"

