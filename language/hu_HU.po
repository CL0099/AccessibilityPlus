msgid "Accessibility Plus Options"
msgstr "Accessibility Plus beállításai"

msgid "Enable Text Scaling"
msgstr "Szövegméret engedélyezése"

msgid "Allow users to scale UI text size."
msgstr "A felhasználók módosíthatják a szöveg méretét."

msgid "Enable Contrast Modes"
msgstr "Kontrasztmódok engedélyezése"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "A felhasználók bekapcsolhatják a magas kontrasztot, az invertált színeket vagy a szürkeárnyalatot."

msgid "Enable Link Highlighting"
msgstr "Hivatkozáskiemelés engedélyezése"

msgid "Allow users to highlight clickable links."
msgstr "A felhasználók kiemelhetik a kattintható hivatkozásokat."

msgid "Enable Font Options"
msgstr "Betűtípus-beállítások engedélyezése"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "A felhasználók jobban olvasható (Atkinson Hyperlegible) vagy diszlexiabarát (OpenDyslexic) betűtípusra válthatnak."

msgid "Enable Text Spacing"
msgstr "Szövegtávolság engedélyezése"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "A felhasználók növelhetik a sor-, betű- és szótávolságot (WCAG 1.4.12 szerinti értékek)."

msgid "Enable Stop Motion"
msgstr "Mozgás leállításának engedélyezése"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "A felhasználók leállíthatják az animációkat, az áttűnéseket és más mozgó tartalmakat."

msgid "Enable Big Cursor"
msgstr "Nagy egérmutató engedélyezése"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "A felhasználók felnagyíthatják az egérmutatót (érintőképernyőn rejtve)."

msgid "Default Widget Position"
msgstr "A gomb alapértelmezett helye"

msgid "Select default corner location for the accessibility button."
msgstr "Válassza ki, melyik sarokban jelenjen meg először az akadálymentességi gomb."

msgid "Bottom Right"
msgstr "Jobbra lent"

msgid "Bottom Left"
msgstr "Balra lent"

