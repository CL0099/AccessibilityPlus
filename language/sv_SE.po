msgid "Accessibility Plus Options"
msgstr "Alternativ för Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Aktivera textstorlek"

msgid "Allow users to scale UI text size."
msgstr "Låt användare ändra textstorleken."

msgid "Enable Contrast Modes"
msgstr "Aktivera kontrastlägen"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Låt användare slå på hög kontrast, inverterade färger eller gråskala."

msgid "Enable Link Highlighting"
msgstr "Aktivera länkmarkering"

msgid "Allow users to highlight clickable links."
msgstr "Låt användare markera klickbara länkar."

msgid "Enable Font Options"
msgstr "Aktivera typsnittsalternativ"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Låt användare byta till ett lättläst (Atkinson Hyperlegible) eller dyslexivänligt (OpenDyslexic) typsnitt."

msgid "Enable Text Spacing"
msgstr "Aktivera textavstånd"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Låt användare öka rad-, bokstavs- och ordavståndet (värden enligt WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Aktivera stoppa rörelse"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Låt användare stoppa animationer, övergångar och annat rörligt innehåll."

msgid "Enable Big Cursor"
msgstr "Aktivera stor muspekare"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Låt användare förstora muspekaren (dold på pekskärmar)."

msgid "Default Widget Position"
msgstr "Knappens standardposition"

msgid "Select default corner location for the accessibility button."
msgstr "Välj i vilket hörn tillgänglighetsknappen visas från början."

msgid "Bottom Right"
msgstr "Nere till höger"

msgid "Bottom Left"
msgstr "Nere till vänster"

