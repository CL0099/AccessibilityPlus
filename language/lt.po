msgid "Accessibility Plus Options"
msgstr "Accessibility Plus parinktys"

msgid "Enable Text Scaling"
msgstr "Įjungti teksto dydžio keitimą"

msgid "Allow users to scale UI text size."
msgstr "Leisti naudotojams keisti teksto dydį."

msgid "Enable Contrast Modes"
msgstr "Įjungti kontrasto režimus"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Leisti naudotojams įjungti didelį kontrastą, invertuotas spalvas arba pilkumo skalę."

msgid "Enable Link Highlighting"
msgstr "Įjungti nuorodų paryškinimą"

msgid "Allow users to highlight clickable links."
msgstr "Leisti naudotojams paryškinti spustelėjamas nuorodas."

msgid "Enable Font Options"
msgstr "Įjungti šrifto parinktis"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Leisti naudotojams pasirinkti lengviau skaitomą (Atkinson Hyperlegible) arba disleksijai pritaikytą (OpenDyslexic) šriftą."

msgid "Enable Text Spacing"
msgstr "Įjungti teksto tarpus"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Leisti naudotojams padidinti tarpus tarp eilučių, raidžių ir žodžių (WCAG 1.4.12 reikšmės)."

msgid "Enable Stop Motion"
msgstr "Įjungti judesio stabdymą"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Leisti naudotojams sustabdyti animacijas, perėjimus ir kitą judantį turinį."

msgid "Enable Big Cursor"
msgstr "Įjungti didelį žymeklį"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Leisti naudotojams padidinti pelės žymeklį (paslėpta jutikliniuose ekranuose)."

msgid "Default Widget Position"
msgstr "Numatytoji mygtuko vieta"

msgid "Select default corner location for the accessibility button."
msgstr "Pasirinkite kampą, kuriame iš pradžių rodomas prieinamumo mygtukas."

msgid "Bottom Right"
msgstr "Apačioje dešinėje"

msgid "Bottom Left"
msgstr "Apačioje kairėje"

