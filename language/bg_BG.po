msgid "Accessibility Plus Options"
msgstr "Настройки на Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Разрешаване на размера на текста"

msgid "Allow users to scale UI text size."
msgstr "Позволява на потребителите да променят размера на текста."

msgid "Enable Contrast Modes"
msgstr "Разрешаване на режимите на контраст"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Позволява на потребителите да включват висок контраст, обърнати цветове или нюанси на сивото."

msgid "Enable Link Highlighting"
msgstr "Разрешаване на открояването на връзки"

msgid "Allow users to highlight clickable links."
msgstr "Позволява на потребителите да откроят връзките, върху които може да се щраква."

msgid "Enable Font Options"
msgstr "Разрешаване на настройките на шрифта"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Позволява на потребителите да преминат към по-четлив шрифт (Atkinson Hyperlegible) или шрифт, подходящ при дислексия (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Разрешаване на разстоянието в текста"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Позволява на потребителите да увеличат разстоянието между редовете, буквите и думите (стойности по WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Разрешаване на спирането на движението"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Позволява на потребителите да спират анимации, преходи и друго движещо се съдържание."

msgid "Enable Big Cursor"
msgstr "Разрешаване на голям курсор"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Позволява на потребителите да уголемят показалеца на мишката (скрито на сензорни екрани)."

msgid "Default Widget Position"
msgstr "Позиция на бутона по подразбиране"

msgid "Select default corner location for the accessibility button."
msgstr "Изберете ъгъла, в който първоначално се показва бутонът за достъпност."

msgid "Bottom Right"
msgstr "Долу вдясно"

msgid "Bottom Left"
msgstr "Долу вляво"

