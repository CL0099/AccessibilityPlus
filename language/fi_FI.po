msgid "Accessibility Plus Options"
msgstr "Accessibility Plus -asetukset"

msgid "Enable Text Scaling"
msgstr "Ota tekstin koko käyttöön"

msgid "Allow users to scale UI text size."
msgstr "Anna käyttäjien muuttaa tekstin kokoa."

msgid "Enable Contrast Modes"
msgstr "Ota kontrastitilat käyttöön"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Anna käyttäjien ottaa käyttöön suuri kontrasti, käänteiset värit tai harmaasävyt."

msgid "Enable Link Highlighting"
msgstr "Ota linkkien korostus käyttöön"

msgid "Allow users to highlight clickable links."
msgstr "Anna käyttäjien korostaa napsautettavat linkit."

msgid "Enable Font Options"
msgstr "Ota fonttivalinnat käyttöön"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Anna käyttäjien vaihtaa helppolukuiseen (Atkinson Hyperlegible) tai lukihäiriöön sopivaan (OpenDyslexic) fonttiin."

msgid "Enable Text Spacing"
msgstr "Ota tekstin välistys käyttöön"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Anna käyttäjien suurentaa rivi-, kirjain- ja sanaväliä (WCAG 1.4.12 -arvot)."

msgid "Enable Stop Motion"
msgstr "Ota liikkeen pysäytys käyttöön"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Anna käyttäjien pysäyttää animaatiot, siirtymät ja muu liikkuva sisältö."

msgid "Enable Big Cursor"
msgstr "Ota suuri osoitin käyttöön"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Anna käyttäjien suurentaa hiiren osoitinta (piilotettu kosketusnäytöillä)."

msgid "Default Widget Position"
msgstr "Painikkeen oletussijainti"

msgid "Select default corner location for the accessibility button."
msgstr "Valitse kulma, jossa saavutettavuuspainike näkyy aluksi."

msgid "Bottom Right"
msgstr "Oikea alakulma"

msgid "Bottom Left"
msgstr "Vasen alakulma"

