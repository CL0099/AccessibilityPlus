msgid "Accessibility Plus Options"
msgstr "Параметры Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Включить изменение размера текста"

msgid "Allow users to scale UI text size."
msgstr "Разрешить пользователям изменять размер текста."

msgid "Enable Contrast Modes"
msgstr "Включить режимы контраста"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Разрешить пользователям включать высокий контраст, инверсию цветов или оттенки серого."

msgid "Enable Link Highlighting"
msgstr "Включить выделение ссылок"

msgid "Allow users to highlight clickable links."
msgstr "Разрешить пользователям выделять кликабельные ссылки."

msgid "Enable Font Options"
msgstr "Включить выбор шрифта"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Разрешить пользователям переключаться на более удобочитаемый шрифт (Atkinson Hyperlegible) или шрифт для людей с дислексией (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Включить интервалы текста"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Разрешить пользователям увеличивать межстрочный, межбуквенный и межсловный интервалы (значения по WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Включить остановку движения"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Разрешить пользователям останавливать анимации, переходы и другое движущееся содержимое."

msgid "Enable Big Cursor"
msgstr "Включить крупный курсор"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Разрешить пользователям увеличивать указатель мыши (скрыто на сенсорных экранах)."

msgid "Default Widget Position"
msgstr "Положение кнопки по умолчанию"

msgid "Select default corner location for the accessibility button."
msgstr "Выберите угол, в котором кнопка специальных возможностей появляется изначально."

