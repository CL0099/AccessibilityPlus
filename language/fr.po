msgid "Accessibility Plus Options"
msgstr "Options d'Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Activer la taille du texte"

msgid "Allow users to scale UI text size."
msgstr "Permettre aux utilisateurs d'agrandir le texte."

msgid "Enable Contrast Modes"
msgstr "Activer les modes de contraste"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Permettre aux utilisateurs d'activer le contraste élevé, l'inversion des couleurs ou les niveaux de gris."

msgid "Enable Link Highlighting"
msgstr "Activer la mise en évidence des liens"

msgid "Allow users to highlight clickable links."
msgstr "Permettre aux utilisateurs de mettre en évidence les liens cliquables."

msgid "Enable Font Options"
msgstr "Activer les options de police"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Permettre aux utilisateurs de passer à une police plus lisible (Atkinson Hyperlegible) ou adaptée à la dyslexie (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Activer l'espacement du texte"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Permettre aux utilisateurs d'augmenter l'interligne et l'espacement des lettres et des mots (valeurs du critère WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Activer l'arrêt des animations"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Permettre aux utilisateurs d'arrêter les animations, les transitions et les autres contenus en mouvement."

msgid "Enable Big Cursor"
msgstr "Activer le grand curseur"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Permettre aux utilisateurs d'agrandir le pointeur de la souris (masqué sur les écrans tactiles)."

msgid "Default Widget Position"
msgstr "Position par défaut du bouton"

msgid "Select default corner location for the accessibility button."
msgstr "Choisissez le coin où le bouton d'accessibilité apparaît par défaut."

msgid "Bottom Right"
msgstr "En bas à droite"

msgid "Bottom Left"
msgstr "En bas à gauche"

