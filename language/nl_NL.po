msgid "Accessibility Plus Options"
msgstr "Opties voor Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Tekstgrootte inschakelen"

msgid "Allow users to scale UI text size."
msgstr "Gebruikers toestaan de tekstgrootte aan te passen."

msgid "Enable Contrast Modes"
msgstr "Contrastmodi inschakelen"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Gebruikers toestaan hoog contrast, omgekeerde kleuren of grijstinten in te schakelen."

msgid "Enable Link Highlighting"
msgstr "Linkmarkering inschakelen"

msgid "Allow users to highlight clickable links."
msgstr "Gebruikers toestaan klikbare links te markeren."

msgid "Enable Font Options"
msgstr "Lettertype-opties inschakelen"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Gebruikers toestaan over te schakelen naar een goed leesbaar (Atkinson Hyperlegible) of dyslexievriendelijk (OpenDyslexic) lettertype."

msgid "Enable Text Spacing"
msgstr "Tekstafstand inschakelen"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Gebruikers toestaan de regel-, letter- en woordafstand te vergroten (waarden volgens WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Beweging stoppen inschakelen"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Gebruikers toestaan animaties, overgangen en andere bewegende inhoud te stoppen."

msgid "Enable Big Cursor"
msgstr "Grote cursor inschakelen"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Gebruikers toestaan de muisaanwijzer te vergroten (verborgen op touchscreens)."

msgid "Default Widget Position"
msgstr "Standaardpositie van de knop"

msgid "Select default corner location for the accessibility button."
msgstr "Kies de hoek waarin de toegankelijkheidsknop eerst verschijnt."

msgid "Bottom Right"
msgstr "Rechtsonder"

msgid "Bottom Left"
msgstr "Linksonder"

