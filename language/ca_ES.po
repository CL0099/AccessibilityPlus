msgid "Accessibility Plus Options"
msgstr "Opcions d'Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Activa la mida del text"

msgid "Allow users to scale UI text size."
msgstr "Permet que els usuaris canviïn la mida del text."

msgid "Enable Contrast Modes"
msgstr "Activa els modes de contrast"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Permet que els usuaris activin el contrast alt, la inversió de colors o l'escala de grisos."

msgid "Enable Link Highlighting"
msgstr "Activa el ressaltat d'enllaços"

msgid "Allow users to highlight clickable links."
msgstr "Permet que els usuaris ressaltin els enllaços on es pot fer clic."

msgid "Enable Font Options"
msgstr "Activa les opcions de lletra"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Permet que els usuaris canviïn a una lletra més llegible (Atkinson Hyperlegible) o adaptada a la dislèxia (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Activa l'espaiat del text"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Permet que els usuaris ampliïn l'interlineat i l'espaiat entre lletres i paraules (valors del criteri WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Activa l'aturada del moviment"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Permet que els usuaris aturin les animacions, les transicions i altres continguts en moviment."

msgid "Enable Big Cursor"
msgstr "Activa el cursor gran"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Permet que els usuaris facin més gran el punter del ratolí (amagat a les pantalles tàctils)."

msgid "Default Widget Position"
msgstr "Posició predeterminada del botó"

msgid "Select default corner location for the accessibility button."
msgstr "Trieu la cantonada on apareix inicialment el botó d'accessibilitat."

msgid "Bottom Right"
msgstr "A baix a la dreta"

msgid "Bottom Left"
msgstr "A baix a l'esquerra"

