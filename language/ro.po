msgid "Accessibility Plus Options"
msgstr "Opțiuni Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Activează mărimea textului"

msgid "Allow users to scale UI text size."
msgstr "Permite utilizatorilor să modifice mărimea textului."

msgid "Enable Contrast Modes"
msgstr "Activează modurile de contrast"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Permite utilizatorilor să activeze contrastul ridicat, culorile inversate sau tonurile de gri."

msgid "Enable Link Highlighting"
msgstr "Activează evidențierea linkurilor"

msgid "Allow users to highlight clickable links."
msgstr "Permite utilizatorilor să evidențieze linkurile pe care se poate da clic."

msgid "Enable Font Options"
msgstr "Activează opțiunile de font"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Permite utilizatorilor să treacă la un font mai lizibil (Atkinson Hyperlegible) sau potrivit pentru dislexie (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Activează spațierea textului"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Permite utilizatorilor să mărească spațiile dintre rânduri, litere și cuvinte (valori conform WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Activează oprirea mișcării"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Permite utilizatorilor să oprească animațiile, tranzițiile și alt conținut în mișcare."

msgid "Enable Big Cursor"
msgstr "Activează cursorul mare"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Permite utilizatorilor să mărească indicatorul mouse-ului (ascuns pe ecranele tactile)."

msgid "Default Widget Position"
msgstr "Poziția implicită a butonului"

msgid "Select default corner location for the accessibility button."
msgstr "Alegeți colțul în care apare inițial butonul de accesibilitate."

msgid "Bottom Right"
msgstr "Dreapta jos"

msgid "Bottom Left"
msgstr "Stânga jos"

