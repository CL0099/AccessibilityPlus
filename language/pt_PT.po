msgid "Accessibility Plus Options"
msgstr "Opções do Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Ativar o tamanho do texto"

msgid "Allow users to scale UI text size."
msgstr "Permitir que os utilizadores alterem o tamanho do texto."

msgid "Enable Contrast Modes"
msgstr "Ativar os modos de contraste"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Permitir que os utilizadores ativem o alto contraste, a inversão de cores ou a escala de cinzentos."

msgid "Enable Link Highlighting"
msgstr "Ativar o realce de ligações"

msgid "Allow users to highlight clickable links."
msgstr "Permitir que os utilizadores realcem as ligações em que é possível clicar."

msgid "Enable Font Options"
msgstr "Ativar as opções de tipo de letra"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Permitir que os utilizadores mudem para um tipo de letra mais legível (Atkinson Hyperlegible) ou adequado à dislexia (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Ativar o espaçamento do texto"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Permitir que os utilizadores aumentem o espaçamento entre linhas, letras e palavras (valores do critério WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Ativar a paragem do movimento"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Permitir que os utilizadores parem animações, transições e outros conteúdos em movimento."

msgid "Enable Big Cursor"
msgstr "Ativar o cursor grande"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Permitir que os utilizadores aumentem o ponteiro do rato (oculto em ecrãs táteis)."

msgid "Default Widget Position"
msgstr "Posição predefinida do botão"

msgid "Select default corner location for the accessibility button."
msgstr "Escolha o canto onde o botão de acessibilidade aparece inicialmente."

msgid "Bottom Right"
msgstr "Canto inferior direito"

msgid "Bottom Left"
msgstr "Canto inferior esquerdo"

