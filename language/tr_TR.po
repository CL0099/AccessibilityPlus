msgid "Accessibility Plus Options"
msgstr "Accessibility Plus seçenekleri"

msgid "Enable Text Scaling"
msgstr "Metin boyutunu etkinleştir"

msgid "Allow users to scale UI text size."
msgstr "Kullanıcıların metin boyutunu değiştirmesine izin ver."

msgid "Enable Contrast Modes"
msgstr "Kontrast modlarını etkinleştir"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Kullanıcıların yüksek kontrastı, ters renkleri veya gri tonlamayı açmasına izin ver."

msgid "Enable Link Highlighting"
msgstr "Bağlantı vurgulamayı etkinleştir"

msgid "Allow users to highlight clickable links."
msgstr "Kullanıcıların tıklanabilir bağlantıları vurgulamasına izin ver."

msgid "Enable Font Options"
msgstr "Yazı tipi seçeneklerini etkinleştir"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Kullanıcıların daha okunaklı (Atkinson Hyperlegible) veya disleksiye uygun (OpenDyslexic) bir yazı tipine geçmesine izin ver."

msgid "Enable Text Spacing"
msgstr "Metin aralığını etkinleştir"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Kullanıcıların satır, harf ve sözcük aralığını artırmasına izin ver (WCAG 1.4.12 değerleri)."

msgid "Enable Stop Motion"
msgstr "Hareketi durdurmayı etkinleştir"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Kullanıcıların animasyonları, geçişleri ve diğer hareketli içeriği durdurmasına izin ver."

msgid "Enable Big Cursor"
msgstr "Büyük imleci etkinleştir"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Kullanıcıların fare işaretçisini büyütmesine izin ver (dokunmatik ekranlarda gizlidir)."

msgid "Default Widget Position"
msgstr "Düğmenin varsayılan konumu"

msgid "Select default corner location for the accessibility button."
msgstr "Erişilebilirlik düğmesinin ilk olarak görüneceği köşeyi seçin."

msgid "Bottom Right"
msgstr "Sağ alt"

msgid "Bottom Left"
msgstr "Sol alt"

