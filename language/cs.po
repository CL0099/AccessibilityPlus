msgid "Accessibility Plus Options"
msgstr "Možnosti Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Povolit změnu velikosti textu"

msgid "Allow users to scale UI text size."
msgstr "Umožnit uživatelům měnit velikost textu."

msgid "Enable Contrast Modes"
msgstr "Povolit režimy kontrastu"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Umožnit uživatelům zapnout vysoký kontrast, inverzní barvy nebo stupně šedi."

msgid "Enable Link Highlighting"
msgstr "Povolit zvýraznění odkazů"

msgid "Allow users to highlight clickable links."
msgstr "Umožnit uživatelům zvýraznit klikací odkazy."

msgid "Enable Font Options"
msgstr "Povolit možnosti písma"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Umožnit uživatelům přepnout na čitelnější písmo (Atkinson Hyperlegible) nebo písmo vhodné při dyslexii (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Povolit rozestupy textu"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Umožnit uživatelům zvětšit řádkování a rozestupy mezi písmeny a slovy (hodnoty podle WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Povolit zastavení pohybu"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Umožnit uživatelům zastavit animace, přechody a další pohyblivý obsah."

msgid "Enable Big Cursor"
msgstr "Povolit velký kurzor"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Umožnit uživatelům zvětšit ukazatel myši (na dotykových obrazovkách skryto)."

msgid "Default Widget Position"
msgstr "Výchozí umístění tlačítka"

msgid "Select default corner location for the accessibility button."
msgstr "Vyberte roh, ve kterém se tlačítko přístupnosti zpočátku zobrazí."

msgid "Bottom Right"
msgstr "Vpravo dole"

msgid "Bottom Left"
msgstr "Vlevo dole"

