msgid "Accessibility Plus Options"
msgstr "Параметри Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Увімкнути зміну розміру тексту"

msgid "Allow users to scale UI text size."
msgstr "Дозволити користувачам змінювати розмір тексту."

msgid "Enable Contrast Modes"
msgstr "Увімкнути режими контрасту"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Дозволити користувачам вмикати високий контраст, інверсію кольорів або відтінки сірого."

msgid "Enable Link Highlighting"
msgstr "Увімкнути виділення посилань"

msgid "Allow users to highlight clickable links."
msgstr "Дозволити користувачам виділяти посилання, на які можна натиснути."

msgid "Enable Font Options"
msgstr "Увімкнути вибір шрифту"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Дозволити користувачам переходити на розбірливіший шрифт (Atkinson Hyperlegible) або шрифт для людей із дислексією (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Увімкнути інтервали тексту"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Дозволити користувачам збільшувати міжрядковий, міжлітерний і міжслівний інтервали (значення за WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Увімкнути зупинку руху"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Дозволити користувачам зупиняти анімації, переходи та інший рухомий вміст."

msgid "Enable Big Cursor"
msgstr "Увімкнути великий курсор"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Дозволити користувачам збільшувати вказівник миші (приховано на сенсорних екранах)."

msgid "Default Widget Position"
msgstr "Типове розташування кнопки"

msgid "Select default corner location for the accessibility button."
msgstr "Виберіть кут, у якому кнопка доступності з'являється спочатку."

msgid "Bottom Right"
msgstr "Праворуч унизу"

msgid "Bottom Left"
msgstr "Ліворуч унизу"

