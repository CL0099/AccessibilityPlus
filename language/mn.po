msgid "Accessibility Plus Options"
msgstr "Accessibility Plus-ийн тохиргоо"

msgid "Enable Text Scaling"
msgstr "Текстийн хэмжээг идэвхжүүлэх"

msgid "Allow users to scale UI text size."
msgstr "Хэрэглэгчдэд текстийн хэмжээг өөрчлөхийг зөвшөөрөх."

msgid "Enable Contrast Modes"
msgstr "Контрастын горимуудыг идэвхжүүлэх"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Хэрэглэгчдэд өндөр контраст, урвуу өнгө эсвэл саарал өнгийг асаахыг зөвшөөрөх."

msgid "Enable Link Highlighting"
msgstr "Холбоос тодруулахыг идэвхжүүлэх"

msgid "Allow users to highlight clickable links."
msgstr "Хэрэглэгчдэд дарж болох холбоосуудыг тодруулахыг зөвшөөрөх."

msgid "Enable Font Options"
msgstr "Фонтын сонголтыг идэвхжүүлэх"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Хэрэглэгчдэд уншихад хялбар (Atkinson Hyperlegible) эсвэл дислекситэй хүнд тохирсон (OpenDyslexic) фонт руу шилжихийг зөвшөөрөх."

msgid "Enable Text Spacing"
msgstr "Текстийн зайг идэвхжүүлэх"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Хэрэглэгчдэд мөр, үсэг, үгийн хоорондын зайг нэмэгдүүлэхийг зөвшөөрөх (WCAG 1.4.12-ийн утгууд)."

msgid "Enable Stop Motion"
msgstr "Хөдөлгөөн зогсоохыг идэвхжүүлэх"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Хэрэглэгчдэд хөдөлгөөнт дүрс, шилжилт болон бусад хөдөлгөөнт агуулгыг зогсоохыг зөвшөөрөх."

msgid "Enable Big Cursor"
msgstr "Том курсорыг идэвхжүүлэх"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Хэрэглэгчдэд хулганы заагчийг томруулахыг зөвшөөрөх (мэдрэгчтэй дэлгэц дээр нуугдана)."

msgid "Default Widget Position"
msgstr "Товчлуурын анхдагч байрлал"

msgid "Select default corner location for the accessibility button."
msgstr "Хүртээмжийн товчлуур эхлээд аль буланд харагдахыг сонгоно уу."

msgid "Bottom Right"
msgstr "Баруун доод"

msgid "Bottom Left"
msgstr "Зүүн доод"

