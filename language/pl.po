msgid "Accessibility Plus Options"
msgstr "Opcje Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Włącz zmianę rozmiaru tekstu"

msgid "Allow users to scale UI text size."
msgstr "Pozwól użytkownikom zmieniać rozmiar tekstu."

msgid "Enable Contrast Modes"
msgstr "Włącz tryby kontrastu"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Pozwól użytkownikom włączać wysoki kontrast, odwrócone kolory lub skalę szarości."

msgid "Enable Link Highlighting"
msgstr "Włącz wyróżnianie linków"

msgid "Allow users to highlight clickable links."
msgstr "Pozwól użytkownikom wyróżniać klikalne linki."

msgid "Enable Font Options"
msgstr "Włącz opcje czcionki"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Pozwól użytkownikom przełączać się na czytelniejszą czcionkę (Atkinson Hyperlegible) lub przyjazną osobom z dysleksją (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Włącz odstępy w tekście"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Pozwól użytkownikom zwiększać odstępy między wierszami, literami i wyrazami (wartości z WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Włącz zatrzymywanie ruchu"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Pozwól użytkownikom zatrzymywać animacje, przejścia i inne ruchome treści."

msgid "Enable Big Cursor"
msgstr "Włącz duży kursor"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Pozwól użytkownikom powiększać wskaźnik myszy (ukryte na ekranach dotykowych)."

msgid "Default Widget Position"
msgstr "Domyślne położenie przycisku"

msgid "Select default corner location for the accessibility button."
msgstr "Wybierz róg, w którym początkowo pojawia się przycisk dostępności."

msgid "Bottom Right"
msgstr "Prawy dolny róg"

msgid "Bottom Left"
msgstr "Lewy dolny róg"

