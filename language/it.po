msgid "Accessibility Plus Options"
msgstr "Opzioni di Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Attiva la dimensione del testo"

msgid "Allow users to scale UI text size."
msgstr "Consenti agli utenti di modificare la dimensione del testo."

msgid "Enable Contrast Modes"
msgstr "Attiva le modalità di contrasto"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Consenti agli utenti di attivare il contrasto elevato, l'inversione dei colori o la scala di grigi."

msgid "Enable Link Highlighting"
msgstr "Attiva l'evidenziazione dei link"

msgid "Allow users to highlight clickable links."
msgstr "Consenti agli utenti di evidenziare i link cliccabili."

msgid "Enable Font Options"
msgstr "Attiva le opzioni dei caratteri"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Consenti agli utenti di passare a un carattere più leggibile (Atkinson Hyperlegible) o adatto alla dislessia (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Attiva la spaziatura del testo"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Consenti agli utenti di aumentare l'interlinea e la spaziatura tra lettere e parole (valori del criterio WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Attiva l'arresto delle animazioni"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Consenti agli utenti di fermare animazioni, transizioni e altri contenuti in movimento."

msgid "Enable Big Cursor"
msgstr "Attiva il cursore grande"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Consenti agli utenti di ingrandire il puntatore del mouse (nascosto sugli schermi touch)."

msgid "Default Widget Position"
msgstr "Posizione predefinita del pulsante"

msgid "Select default corner location for the accessibility button."
msgstr "Scegli l'angolo in cui appare inizialmente il pulsante di accessibilità."

msgid "Bottom Right"
msgstr "In basso a destra"

msgid "Bottom Left"
msgstr "In basso a sinistra"

