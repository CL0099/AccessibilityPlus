msgid "Accessibility Plus Options"
msgstr "Опције за Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Омогући величину текста"

msgid "Allow users to scale UI text size."
msgstr "Дозволи корисницима да мењају величину текста."

msgid "Enable Contrast Modes"
msgstr "Омогући режиме контраста"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Дозволи корисницима да укључе висок контраст, обрнуте боје или нијансе сиве."

msgid "Enable Link Highlighting"
msgstr "Омогући истицање веза"

msgid "Allow users to highlight clickable links."
msgstr "Дозволи корисницима да истакну везе на које може да се кликне."

msgid "Enable Font Options"
msgstr "Омогући опције фонта"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Дозволи корисницима да пређу на читљивији фонт (Atkinson Hyperlegible) или фонт прилагођен дислексији (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Омогући размак текста"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Дозволи корисницима да повећају размак између редова, слова и речи (вредности према WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Омогући заустављање покрета"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Дозволи корисницима да зауставе анимације, прелазе и други покретни садржај."

msgid "Enable Big Cursor"
msgstr "Омогући велики показивач"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Дозволи корисницима да увећају показивач миша (скривено на екранима осетљивим на додир)."

msgid "Default Widget Position"
msgstr "Подразумевани положај дугмета"

msgid "Select default corner location for the accessibility button."
msgstr "Изаберите угао у ком се дугме за приступачност најпре приказује."

msgid "Bottom Right"
msgstr "Доле десно"

msgid "Bottom Left"
msgstr "Доле лево"

