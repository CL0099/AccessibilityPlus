msgid "Accessibility Plus Options"
msgstr "Opciones de Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Activar el tamaño del texto"

msgid "Allow users to scale UI text size."
msgstr "Permitir que los usuarios cambien el tamaño del texto."

msgid "Enable Contrast Modes"
msgstr "Activar los modos de contraste"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Permitir que los usuarios activen el contraste alto, la inversión de colores o la escala de grises."

msgid "Enable Link Highlighting"
msgstr "Activar el resaltado de enlaces"

msgid "Allow users to highlight clickable links."
msgstr "Permitir que los usuarios resalten los enlaces en los que se puede hacer clic."

msgid "Enable Font Options"
msgstr "Activar las opciones de fuente"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Permitir que los usuarios cambien a una fuente más legible (Atkinson Hyperlegible) o adaptada para la dislexia (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Activar el espaciado del texto"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Permitir que los usuarios amplíen el interlineado y el espaciado entre letras y palabras (valores de la pauta WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Activar la detención del movimiento"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Permitir que los usuarios detengan las animaciones, las transiciones y otros contenidos en movimiento."

msgid "Enable Big Cursor"
msgstr "Activar el cursor grande"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Permitir que los usuarios agranden el puntero del mouse (oculto en pantallas táctiles)."

msgid "Default Widget Position"
msgstr "Posición predeterminada del botón"

msgid "Select default corner location for the accessibility button."
msgstr "Elige la esquina en la que aparece inicialmente el botón de accesibilidad."

msgid "Bottom Right"
msgstr "Abajo a la derecha"

msgid "Bottom Left"
msgstr "Abajo a la izquierda"

