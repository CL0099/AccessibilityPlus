msgid "Accessibility Plus Options"
msgstr "Mogućnosti dodatka Accessibility Plus"

msgid "Enable Text Scaling"
msgstr "Omogući veličinu teksta"

msgid "Allow users to scale UI text size."
msgstr "Dopusti korisnicima da mijenjaju veličinu teksta."

msgid "Enable Contrast Modes"
msgstr "Omogući načine kontrasta"

msgid "Allow users to toggle high contrast, invert, or grayscale."
msgstr "Dopusti korisnicima da uključe visoki kontrast, obrnute boje ili sive tonove."

msgid "Enable Link Highlighting"
msgstr "Omogući isticanje poveznica"

msgid "Allow users to highlight clickable links."
msgstr "Dopusti korisnicima da istaknu poveznice na koje se može kliknuti."

msgid "Enable Font Options"
msgstr "Omogući mogućnosti fonta"

msgid "Allow users to switch to a readable (Atkinson Hyperlegible) or dyslexia (OpenDyslexic) font."
msgstr "Dopusti korisnicima da prijeđu na čitljiviji font (Atkinson Hyperlegible) ili font prilagođen disleksiji (OpenDyslexic)."

msgid "Enable Text Spacing"
msgstr "Omogući razmak teksta"

msgid "Allow users to widen line, letter and word spacing (WCAG 1.4.12 values)."
msgstr "Dopusti korisnicima da povećaju razmak između redaka, slova i riječi (vrijednosti prema WCAG 1.4.12)."

msgid "Enable Stop Motion"
msgstr "Omogući zaustavljanje kretanja"

msgid "Allow users to stop animations, transitions and other moving content."
msgstr "Dopusti korisnicima da zaustave animacije, prijelaze i drugi pokretni sadržaj."

msgid "Enable Big Cursor"
msgstr "Omogući veliki pokazivač"

msgid "Allow users to enlarge the mouse pointer (hidden on touch screens)."
msgstr "Dopusti korisnicima da povećaju pokazivač miša (skriveno na zaslonima osjetljivim na dodir)."

msgid "Default Widget Position"
msgstr "Zadani položaj gumba"

msgid "Select default corner location for the accessibility button."
msgstr "Odaberite kut u kojem se gumb za pristupačnost prvo prikazuje."

msgid "Bottom Right"
msgstr "Dolje desno"

msgid "Bottom Left"
msgstr "Dolje lijevo"

